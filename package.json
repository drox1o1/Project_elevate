  "license": "MIT",
  "description": "An open-source, agent-ready design engineering system: production React components with the full interaction state matrix, engineered motion and design tokens, discoverable over MCP.",
  "author": "Durgesh Kukreti (DUKU Labs)",
  "homepage": "https://labs.duku.design",
  "repository": {
    "type": "git",
