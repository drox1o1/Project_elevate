  },
  "keywords": [
    "react",
    "shadcn",
    "registry",
    "components",
    "design-system",
    "mcp",
    "tailwindcss",
    "open-source"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "registry:build": "shadcn build",
    "registry:gen": "node scripts/gen-registry.mjs",
    "cf:build": "node scripts/gen-registry.mjs && next build && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy"
  },
